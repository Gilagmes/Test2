{
  "name": "telegram-shonen-moba-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node server/app.js",
    "dev:bot": "node bot/bot.js",
    "build": "tsc && vite build",
    "build:web": "npm run build && npm run db:generate",
    "preview": "vite preview --host 0.0.0.0",
    "start": "SERVE_CLIENT=true node server/app.js",
    "start:server": "node server/app.js",
    "start:web": "SERVE_CLIENT=true node server/app.js",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://shonen:shonen_dev_password@localhost:5432/shonen_rift?schema=public} prisma generate",
    "db:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://shonen:shonen_dev_password@localhost:5432/shonen_rift?schema=public} prisma validate",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-postgresql://shonen:shonen_dev_password@localhost:5432/shonen_rift?schema=public} prisma migrate dev",
    "db:deploy": "DATABASE_URL=${DATABASE_URL:-postgresql://shonen:shonen_dev_password@localhost:5432/shonen_rift?schema=public} prisma migrate deploy",
    "db:studio": "DATABASE_URL=${DATABASE_URL:-postgresql://shonen:shonen_dev_password@localhost:5432/shonen_rift?schema=public} prisma studio",
    "dev:postgres": "docker compose up -d postgres",
    "dev:server:prisma": "DATABASE_URL=${DATABASE_URL:-postgresql://shonen:shonen_dev_password@localhost:5432/shonen_rift?schema=public} STORAGE_DRIVER=prisma node server/app.js",
    "prod:up": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "prod:logs": "docker compose --env-file .env.production -f docker-compose.prod.yml logs -f --tail=200",
    "prod:ps": "docker compose --env-file .env.production -f docker-compose.prod.yml ps",
    "smoke:validation": "./scripts/smoke-validation.sh",
    "smoke:strict-shared-sim": "node scripts/smoke-strict-shared-sim.mjs",
    "smoke:shared-tutorial": "node scripts/smoke-shared-tutorial.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "fastify": "^4.29.0",
    "grammy": "^1.34.0",
    "phaser": "^3.90.0",
    "vite": "^5.4.19"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prisma": "^5.22.0"
  }
}
